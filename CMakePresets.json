{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },

    "configurePresets": [
        {
            "name": "x86_64-debug",
            "displayName": "x86-64 Kernel Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/x86_64-kernel.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "x86_64-debug",
            "configurePreset": "x86_64-debug"
        }
    ]
}
